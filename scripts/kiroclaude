#!/bin/sh
set -eu

fail() {
  printf 'kiroclaude: %s\n' "$1" >&2
  exit 1
}

resolve_effort() {
  case "$1" in
    ultra | ultracode)
      resolved_effort=max
      resolved_ultracode=true
      ;;
    low | medium | high | xhigh | max)
      resolved_effort=$1
      resolved_ultracode=false
      ;;
    *) fail "unsupported effort '$1' (use ultra, low, medium, high, xhigh, or max)" ;;
  esac
}

resolve_permission_mode() {
  case "$1" in
    acceptEdits | auto | bypassPermissions | manual | dontAsk | plan)
      resolved_permission_mode=$1
      ;;
    *)
      fail "unsupported permission mode '$1' (use bypassPermissions, acceptEdits, auto, manual, dontAsk, or plan)"
      ;;
  esac
}

home=${HOME:-}
[ -n "$home" ] || fail 'HOME is not set'

backend=${KIROCLAUDE_BACKEND:-kiro}
case "${1:-}" in
  --bedrock-fable)
    backend=bedrock-fable
    shift
    ;;
  --kiro)
    backend=kiro
    shift
    ;;
esac

claude_bin=${KIROCLAUDE_CLAUDE_BIN:-claude}
command -v "$claude_bin" >/dev/null 2>&1 || fail "Claude Code executable not found: $claude_bin"

case "$backend" in
  kiro)
    config_dir=${KIROCLAUDE_CONFIG_DIR-${CLAUDE_CONFIG_DIR-}}
    ;;
  bedrock-fable | fable)
    backend=bedrock-fable
    config_dir=${KIROCLAUDE_CONFIG_DIR-${CLAUDE_CONFIG_DIR-}}
    ;;
  *) fail "unsupported backend '$backend' (use kiro or bedrock-fable)" ;;
esac
if [ -n "$config_dir" ] && [ -e "$config_dir" ] && [ ! -d "$config_dir" ]; then
  fail "Claude config path is not a directory: $config_dir"
fi

permission_mode=${KIROCLAUDE_PERMISSION_MODE:-}
skip_dangerous_prompt=false
if [ -n "$permission_mode" ]; then
  resolve_permission_mode "$permission_mode"
  permission_mode=$resolved_permission_mode
  if [ "$permission_mode" = bypassPermissions ]; then
    skip_dangerous_prompt=true
  fi
fi

if [ "$backend" = kiro ]; then
  script_dir=$(unset CDPATH; cd -P "$(dirname "$0")" && pwd)
  helper=${KIROCLAUDE_TOKEN_HELPER:-"$script_dir/kiroclaude-token"}
  [ -x "$helper" ] || fail "token helper is not executable: $helper"

  provider_config=${KIROCLAUDE_PROVIDER_CONFIG:-"${XDG_CONFIG_HOME:-$home/.config}/kiro-provider/config.json"}
  base_url=${KIROCLAUDE_BASE_URL:-http://127.0.0.1:8787}
  model=${KIROCLAUDE_MODEL:-opus}
  resolve_effort "${KIROCLAUDE_EFFORT:-ultra}"
  # Claude Code uses a conservative window behind custom gateways unless the
  # client model explicitly declares [1m]. Claude strips this client-only suffix
  # before sending the model ID. Custom pins remain exactly as supplied.
  opus_model=${KIROCLAUDE_OPUS_MODEL:-claude-opus-5[1m]}
  sonnet_model=${KIROCLAUDE_SONNET_MODEL:-claude-sonnet-5[1m]}
  # Claude Code uses its small-fast model for prompt hooks and sends max_tokens.
  # Kiro Haiku 4.5 rejects additionalModelRequestFields, so use the
  # probe-confirmed Sonnet 5 mapping unless the operator explicitly overrides it.
  haiku_model=${KIROCLAUDE_HAIKU_MODEL:-claude-sonnet-5[1m]}
  kiro_fable_model=${KIROCLAUDE_KIRO_FABLE_MODEL:-claude-fable-5-1[1m]}
  sol_model=${KIROCLAUDE_SOL_MODEL:-gpt-5.6-sol[1m]}
  terra_model=${KIROCLAUDE_TERRA_MODEL:-gpt-5.6-terra[1m]}
  luna_model=${KIROCLAUDE_LUNA_MODEL:-gpt-5.6-luna[1m]}

  settings=$(python3 - "$helper" "$base_url" "$model" "$resolved_effort" "$resolved_ultracode" "$permission_mode" "$skip_dangerous_prompt" "$opus_model" "$sonnet_model" "$haiku_model" "$kiro_fable_model" "$sol_model" "$terra_model" "$luna_model" <<'PY'
import json
import hashlib
import os
import shlex
import sys
from urllib.parse import urlsplit

(
    helper,
    base_url,
    model,
    effort,
    ultracode,
    permission_mode,
    skip_dangerous_prompt,
    opus,
    sonnet,
    haiku,
    fable,
    sol,
    terra,
    luna,
) = sys.argv[1:]
parsed = urlsplit(base_url)
if parsed.scheme not in {"http", "https"} or not parsed.netloc:
    raise SystemExit("kiroclaude: KIROCLAUDE_BASE_URL must be an absolute http(s) URL")
if parsed.query or parsed.fragment or parsed.path.rstrip("/"):
    raise SystemExit("kiroclaude: KIROCLAUDE_BASE_URL must be the gateway root, without /v1 or another path")
if not all(value.strip() for value in (model, effort, opus, sonnet, haiku, fable, sol, terra, luna)):
    raise SystemExit("kiroclaude: model and effort settings must not be empty")
settings = {
    "apiKeyHelper": shlex.quote(helper),
    "model": model,
    # Keep proactive compaction enabled for gateway models whose [1m] window
    # would otherwise use reactive overflow handling. Claude clamps this to
    # each model's window; --autocompact and the native environment override win.
    "autoCompactWindow": 1000000,
    "effortLevel": effort,
    "ultracode": ultracode == "true",
    "awaySummaryEnabled": False,
    "modelPicker": {
        "replaceBuiltInOptions": False,
        "options": [
            {"model": sol, "label": "GPT-5.6 Sol", "description": "Kiro GPT flagship", "behavesAs": "claude-opus-5"},
            {"model": terra, "label": "GPT-5.6 Terra", "description": "Kiro GPT balanced", "behavesAs": "claude-opus-5"},
            {"model": luna, "label": "GPT-5.6 Luna", "description": "Kiro GPT efficient", "behavesAs": "claude-opus-5"},
        ],
    },
    "env": {
        # --settings outranks ~/.claude/settings.json. Explicit false/empty
        # values prevent a shared native Bedrock/Vertex profile from selecting
        # that provider or replacing the Kiro endpoint/authentication.
        "CLAUDE_CODE_USE_BEDROCK": "0",
        "CLAUDE_CODE_USE_VERTEX": "0",
        "CLAUDE_CODE_USE_FOUNDRY": "0",
        "CLAUDE_CODE_USE_MANTLE": "0",
        # These native per-tool reminders disappear from later client history.
        # Kiro's inline system projection would make that a signed-prefix edit.
        "CLAUDE_CODE_TOASTY_THIMBLE": "0",
        "CLAUDE_CODE_GENTLE_PARASOL": "0",
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_AUTH_TOKEN": "",
        "ANTHROPIC_BEDROCK_BASE_URL": "",
        "ANTHROPIC_VERTEX_BASE_URL": "",
        "ANTHROPIC_FOUNDRY_BASE_URL": "",
        "ANTHROPIC_AWS_BASE_URL": "",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": fable,
        "ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES": "",
        "ANTHROPIC_BASE_URL": base_url.rstrip("/"),
        "ANTHROPIC_DEFAULT_OPUS_MODEL": opus,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": sonnet,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": haiku,
        "ANTHROPIC_CUSTOM_HEADERS": "\n".join([
            "X-Kiro-Output-Token-Limit-Mode: advisory",
            "X-Kiro-Client-Normalization: claude-code-bash-v1",
            "X-Kiro-Working-Directory-Hash: " + hashlib.sha256(
                b"kiro-provider-working-directory-v1\0" + os.getcwd().encode("utf-8")
            ).hexdigest(),
        ]),
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0",
    },
}
if permission_mode:
    settings["permissions"] = {"defaultMode": permission_mode}
    settings["skipDangerousModePermissionPrompt"] = skip_dangerous_prompt == "true"
print(json.dumps(settings, separators=(",", ":")))
PY
  ) || exit $?
else
  model=${KIROCLAUDE_MODEL:-fable}
  resolve_effort "${KIROCLAUDE_FABLE_EFFORT:-max}"
  aws_profile=${KIROCLAUDE_AWS_PROFILE:-us-claude}
  aws_region=${KIROCLAUDE_AWS_REGION:-us-east-2}
  fable_model=${KIROCLAUDE_FABLE_MODEL:-us.anthropic.claude-fable-5-1}

  settings=$(python3 - "$model" "$resolved_effort" "$resolved_ultracode" "$permission_mode" "$skip_dangerous_prompt" "$aws_profile" "$aws_region" "$fable_model" <<'PY'
import json
import sys

model, effort, ultracode, permission_mode, skip_dangerous_prompt, profile, region, fable = sys.argv[1:]
if not all(value.strip() for value in (model, effort, profile, region, fable)):
    raise SystemExit("kiroclaude: Bedrock Fable settings must not be empty")
settings = {
    "model": model,
    "effortLevel": effort,
    "ultracode": ultracode == "true",
    "awaySummaryEnabled": False,
    "modelPicker": {
        "replaceBuiltInOptions": True,
        "options": [{
            "model": "fable",
            "label": "Claude Fable 5.1 (Bedrock)",
            "description": f"{fable} via AWS profile {profile}",
        }],
    },
    "env": {
        "CLAUDE_CODE_USE_BEDROCK": "1",
        "CLAUDE_CODE_USE_VERTEX": "0",
        "CLAUDE_CODE_USE_FOUNDRY": "0",
        "CLAUDE_CODE_USE_MANTLE": "0",
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_AUTH_TOKEN": "",
        "ANTHROPIC_BASE_URL": "",
        "ANTHROPIC_BEDROCK_BASE_URL": "",
        "ANTHROPIC_VERTEX_BASE_URL": "",
        "ANTHROPIC_FOUNDRY_BASE_URL": "",
        "ANTHROPIC_AWS_BASE_URL": "",
        "AWS_PROFILE": profile,
        "AWS_REGION": region,
        "AWS_DEFAULT_REGION": region,
        "ANTHROPIC_DEFAULT_FABLE_MODEL": fable,
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0",
    },
}
if permission_mode:
    settings["permissions"] = {"defaultMode": permission_mode}
    settings["skipDangerousModePermissionPrompt"] = skip_dangerous_prompt == "true"
print(json.dumps(settings, separators=(",", ":")))
PY
  ) || exit $?
fi

# Preserve Claude's native config resolution (normally ~/.claude plus
# ~/.claude.json) so skills, commands, plugins, settings, history, and sessions
# remain shared. KIROCLAUDE_CONFIG_DIR is the explicit isolation escape hatch.
if [ -n "$config_dir" ]; then
  export CLAUDE_CONFIG_DIR="$config_dir"
else
  unset CLAUDE_CONFIG_DIR
fi
export CLAUDE_CODE_ENABLE_AWAY_SUMMARY=0
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_CUSTOM_HEADERS
unset ANTHROPIC_BEDROCK_BASE_URL ANTHROPIC_VERTEX_BASE_URL
unset ANTHROPIC_FOUNDRY_BASE_URL ANTHROPIC_AWS_BASE_URL
unset ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES
unset CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY CLAUDE_CODE_USE_MANTLE
unset CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS ENABLE_TOOL_SEARCH

if [ "$backend" = kiro ]; then
  export KIRO_PROVIDER_CONFIG="$provider_config"
  unset CLAUDE_CODE_USE_BEDROCK
  unset ANTHROPIC_DEFAULT_FABLE_MODEL
else
  unset KIRO_PROVIDER_CONFIG
  export CLAUDE_CODE_USE_BEDROCK=1
  export AWS_PROFILE="$aws_profile"
  export AWS_REGION="$aws_region"
  export AWS_DEFAULT_REGION="$aws_region"
  export ANTHROPIC_DEFAULT_FABLE_MODEL="$fable_model"
fi

exec "$claude_bin" --settings "$settings" "$@"
