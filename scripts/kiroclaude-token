#!/usr/bin/env python3
"""Print one local kiro-provider API key for Claude Code's apiKeyHelper."""

from __future__ import annotations

import json
import os
import stat
import sys
from pathlib import Path


def fail(message: str) -> int:
    print(f"kiroclaude-token: {message}", file=sys.stderr)
    return 1


def main() -> int:
    if len(sys.argv) != 1:
        return fail("this helper accepts no arguments")
    home = Path.home()
    configured = os.environ.get("KIRO_PROVIDER_CONFIG")
    config_path = (
        Path(configured).expanduser()
        if configured
        else Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
        / "kiro-provider"
        / "config.json"
    )
    try:
        metadata = config_path.stat()
        if not stat.S_ISREG(metadata.st_mode):
            return fail("provider configuration is not a regular file")
        if hasattr(os, "getuid") and metadata.st_uid != os.getuid():
            return fail("provider configuration is not owned by the current user")
        if metadata.st_mode & 0o077:
            return fail("provider configuration permissions must be 0600 or stricter")
        value = json.loads(config_path.read_text(encoding="utf-8"))
        keys = value.get("api_keys") if isinstance(value, dict) else None
        if not isinstance(keys, list):
            return fail("provider configuration has no api_keys list")
        token = next(
            candidate.strip()
            for candidate in keys
            if isinstance(candidate, str) and candidate.strip()
        )
    except (OSError, UnicodeError, json.JSONDecodeError, StopIteration) as error:
        return fail(f"cannot read a valid provider API key ({type(error).__name__})")
    if "\n" in token or "\r" in token:
        return fail("provider API key must be a single line")
    print(token)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
